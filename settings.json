{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_COORDINATOR_MODE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(claude team:*)",
      "Bash(claude:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Read(~/Library/Containers/**)",
      "Read(~/Library/Group Containers/**)",
      "Read(~/Library/Application Support/**)",
      "Bash(find ~/Library*)",
      "Bash(ls ~/Library/Containers*)",
      "Bash(ls ~/Library/Group Containers*)",
      "Bash(ls ~/Library/Application Support*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR:-.}/.remember/logs\""
          },
          {
            "type": "command",
            "command": "bash /Users/alilloig/.claude/hooks/refresh-sui-pilot-symlink.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/alilloig/.claude/statusline-command.sh"
  },
