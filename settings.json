{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_COORDINATOR_MODE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(claude team:*)",
      "Bash(claude:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Read(~/Library/Containers/**)",
      "Read(~/Library/Group Containers/**)",
      "Read(~/Library/Application Support/**)",
      "Bash(find ~/Library*)",
      "Bash(ls ~/Library/Containers*)",
      "Bash(ls ~/Library/Group Containers*)",
      "Bash(ls ~/Library/Application Support*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR:-.}/.remember/logs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/alilloig/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "slack@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "notion@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "ralph-loop@claude-plugins-official": true,
    "code-forge@contract-hero": true,
    "codex-bridge@contract-hero": true,
    "sui-pilot@contract-hero": true,
    "agentic-community-college@contract-hero": true,
    "acc-deepbook-course@contract-hero": true,
    "toolkit@contract-hero": true,
    "acc-evm-wal@contract-hero": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "contract-hero": {
      "source": {
        "source": "github",
        "repo": "contract-hero/plugin-marketplace"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "preferredNotifChannel": "iterm2",
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
